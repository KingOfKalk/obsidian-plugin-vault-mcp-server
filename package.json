{
  "name": "vault-mcp-server",
  "version": "4.0.1",
  "description": "Exposes your Obsidian vault as a Model Context Protocol server for AI assistants",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && xvfb-run -a wdio run ./wdio.conf.mts",
    "lint": "eslint src/ tests/ scripts/ evals/ e2e/",
    "lint:fix": "eslint src/ tests/ scripts/ evals/ e2e/ --fix",
    "format": "prettier --write src/ tests/",
    "format:check": "prettier --check src/ tests/",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "eval": "tsx evals/run.ts",
    "docs:tools": "tsx scripts/list-tools.ts docs",
    "surface:measure": "tsx scripts/measure-surface.ts",
    "surface:update": "tsx scripts/measure-surface.ts --json docs/surface-baseline.json",
    "docs:check": "rm -rf /tmp/tools.check && mkdir -p /tmp/tools.check && tsx scripts/list-tools.ts /tmp/tools.check && diff -u docs/tools.generated.md /tmp/tools.check/tools.generated.md && diff -ru docs/tools/ /tmp/tools.check/tools/"
  },
  "keywords": [
    "obsidian",
    "mcp",
    "model-context-protocol"
  ],
  "author": "KingOfKalk",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "@wdio/cli": "^10.2.0",
    "@wdio/globals": "^10.2.0",
    "@wdio/local-runner": "^10.2.0",
    "@wdio/mocha-framework": "^10.2.0",
    "builtin-modules": "^5.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "5.0.5",
    "wdio-obsidian-reporter": "^3.5.0",
    "wdio-obsidian-service": "^3.5.0",
    "webdriverio": "^10.2.0",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "moment": "^2.31.0",
    "obsidian": "^1.14.4",
    "selfsigned": "^5.5.0",
    "zod": "^4.6.7"
  }
}
