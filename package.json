{
  "name": "vault-mcp-server",
  "version": "3.1.5",
  "description": "Exposes your Obsidian vault as a Model Context Protocol server for AI assistants",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/ scripts/ evals/",
    "lint:fix": "eslint src/ tests/ scripts/ evals/ --fix",
    "format": "prettier --write src/ tests/",
    "format:check": "prettier --check src/ tests/",
    "typecheck": "tsc --noEmit",
    "eval": "tsx evals/run.ts",
    "docs:tools": "tsx scripts/list-tools.ts docs",
    "docs:check": "rm -rf /tmp/tools.check && mkdir -p /tmp/tools.check && tsx scripts/list-tools.ts /tmp/tools.check && diff -u docs/tools.generated.md /tmp/tools.check/tools.generated.md && diff -ru docs/tools/ /tmp/tools.check/tools/"
  },
  "keywords": [
    "obsidian",
    "mcp",
    "model-context-protocol"
  ],
  "author": "KingOfKalk",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "builtin-modules": "^5.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "moment": "^2.31.0",
    "obsidian": "^1.14.4",
    "selfsigned": "^5.5.0",
    "zod": "^4.6.7"
  }
}
